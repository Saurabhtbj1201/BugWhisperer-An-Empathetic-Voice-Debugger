# ==========================================
# BugWhisperer Environment Configuration
# ==========================================

# Open-Weight AI Brain (Gemma 2)
# Supported options:
# 1. Groq (Fastest free cloud endpoint running Gemma 2 9B IT): https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMMA_MODEL=gemma2-9b-it

# 2. Local Ollama (100% offline & private)
# OLLAMA_BASE_URL=http://localhost:11434

# 3. Hugging Face Inference API
# HUGGINGFACE_API_KEY=hf_your_key_here

# ElevenLabs Voice Synthesis (Hacktoberfest Partner)
# Free credits available at: https://hacktoberfest.com/my/promos
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Sentry Agent Tracing (Hacktoberfest Partner)
# Get a free DSN at: https://sentry.io/
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0

# App Server
PORT=8000
ENVIRONMENT=development
